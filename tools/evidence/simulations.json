{
  "schema_version": 1,
  "project": "PicoRV32 CPU + DMA + Bus Firewall",
  "tests": [
    {
      "id": "dma_fifo", "scope": "DMA_UNIT", "top": "tb_dma_fifo_latch",
      "sources": ["DMA-controller/rtl/dma_fifo_latch.v", "DMA-controller/tb/tb_dma_fifo_latch.v"],
      "pass_pattern": "\\[PASS\\] tb_dma_fifo_latch completed with no check failures",
      "waveform": "fifo_wave.vcd", "signals": ["*clk", "*rst_n", "*push", "*pop", "*full", "*empty", "*count", "*wdata", "*rdata"]
    },
    {
      "id": "dma_apb", "scope": "DMA_UNIT", "top": "tb_dma_apb_slave",
      "sources": ["DMA-controller/rtl/dma_apb_slave.v", "DMA-controller/tb/tb_dma_apb_slave.v"],
      "pass_pattern": "\\[PASS\\] tb_dma_apb_slave completed with no check failures",
      "waveform": "apb_slave_wave.vcd", "signals": ["*clk", "*rst_n", "*psel", "*penable", "*pwrite", "*paddr", "*pready", "*pslverr", "*cfg_start"]
    },
    {
      "id": "dma_axi", "scope": "DMA_UNIT", "top": "tb_dma_axi_master",
      "sources": ["DMA-controller/rtl/dma_axi_master.v", "DMA-controller/tb/tb_dma_axi_master.v"],
      "pass_pattern": "\\[PASS\\] tb_dma_axi_master V2.4.1 negative regression",
      "signals": ["*clk", "*rst_n", "*awvalid", "*awready", "*wvalid", "*wready", "*wlast", "*bvalid", "*bresp", "*arvalid", "*rvalid", "*rlast"]
    },
    {
      "id": "dma_controller", "scope": "DMA_UNIT", "top": "tb_dma_controller",
      "sources": ["DMA-controller/rtl/dma_apb_slave.v", "DMA-controller/rtl/dma_axi_master.v", "DMA-controller/rtl/dma_fifo_latch.v", "DMA-controller/rtl/dma_controller.v", "DMA-controller/tb/tb_dma_controller.v"],
      "pass_pattern": "\\[PASS\\] dma_controller regression:",
      "signals": ["*clk", "*rst_n", "*dma_ctx_valid", "*dma_ctx_done", "*dma_irq", "*awvalid", "*wvalid", "*bresp", "*arvalid", "*rvalid"]
    },
    {
      "id": "picorv32_smoke", "scope": "CPU_SMOKE", "top": "testbench",
      "sources": ["picorv32-main/picorv32-main/picorv32.v", "picorv32-main/picorv32-main/testbench_ez.v"],
      "pass_pattern": "write  0x000003fc: 0x00000005 \\(wstrb=1111\\)",
      "waveform": "testbench.vcd", "plusargs": ["+vcd"],
      "iverilog_flags": ["-Wno-sensitivity-entire-array"],
      "note": "Upstream increment-loop smoke: observes write of 5 to 0x3fc. Not ISA compliance or CPU-SoC integration verification.",
      "signals": ["*clk", "*resetn", "*trap", "*mem_valid", "*mem_ready", "*mem_instr", "*mem_addr", "*mem_wdata", "*mem_rdata"]
    },
    {

      "pass_pattern": "PASS: tb_fw_drain_fsm",
      "signals": ["*clk", "*rst_n", "*acl_w_fault", "*w_drain_wvalid", "*w_drain_wready", "*w_drain_bvalid", "*acl_r_fault", "*r_drain_rvalid", "*r_drain_rready", "*r_drain_rlast"]
    },

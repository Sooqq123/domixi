    connect \r_drain_rlast \r_drain_rlast
    connect \r_drain_rid \r_drain_rid
    connect \r_drain_rdata \r_drain_rdata
    connect \clk \clk
    connect \acl_r_len \acl_r_len
    connect \acl_r_id \acl_r_id
    connect \acl_r_fault \acl_r_fault
    connect \acl_r_err_mode \acl_r_err_mode
  end
end
